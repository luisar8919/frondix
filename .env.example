# Supabase (Proyecto > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Culqi (culqi.com > Llaves API)
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_PLAN_ID=

# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=un-secreto-que-vos-inventes

# Anthropic / Claude (console.anthropic.com > API Keys) - solo para "Sugerir con IA"
# en el asistente de Crear módulos. Sin esta variable esa función avisa que falta configurarla.
ANTHROPIC_API_KEY=

# Firebase Cloud Messaging (Firebase Console > Configuración del proyecto > Cuentas
# de servicio > Generar nueva clave privada) -- notificaciones push a la app móvil.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Secreto compartido con el workflow de GitHub Actions que llama al cron de
# notificaciones de seguimiento (ver .github/workflows/seguimiento-push.yml).
CRON_SECRET=

# PayPal (developer.paypal.com > tu app > Sandbox o Live) -- suscripcion internacional en USD.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_PLAN_ID=
PAYPAL_ENV=sandbox

# Paddle (paddle.com > Developer Tools) -- suscripcion internacional, Paddle factura el
# IVA/VAT de cada pais por vos (merchant of record).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
